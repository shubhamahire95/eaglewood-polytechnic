# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
# Connection string (URI) → use "Session pooler" or "Transaction pooler"
SUPABASE_DB_URL=postgresql://postgres.rhqmquaojetmzdznbevz:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Required for image migration (npm run migrate:images)
# Dashboard → Project Settings → API → service_role (secret — never commit)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional fallback when using: npm run migrate:images -- --admin-auth
# (requires supabase/migrations/009_production_stabilize.sql applied first)
ADMIN_EMAIL=admin@eaglewoodpoly.in
ADMIN_PASSWORD=admin123
